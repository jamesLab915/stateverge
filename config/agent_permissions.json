{
  "version": "agent_production_assist_v1",
  "host_mode": "PRO_ONLY",
  "permissions": {
    "monitor_system": true,
    "restart_server_mode": true,
    "cleanup_stale_locks": true,
    "run_diagnostics": true,
    "run_dry_runs": true,
    "edit_video_selection_logic": true,
    "edit_shorts_highlight_logic": true,
    "edit_long_assembly_logic": true,
    "edit_audio_policy_logic": true,
    "edit_metadata_templates": true,
    "edit_youtube_ops_logic": true,
    "edit_dashboard_ui": true,
    "create_new_scripts": true,
    "modify_existing_scripts": true,
    "write_reports": true,
    "organize_assets_when_idle": true,
    "build_media_index": true,
    "generate_thumbnails": true,
    "classify_assets": true,
    "prepare_publish_packages": true,
    "generate_metadata": true,
    "generate_dry_run_renders": true,
    "real_upload_private": true,
    "real_upload_public": false,
    "real_upload_scheduled_public": false,
    "real_upload": false,
    "delete_raw_media": false,
    "delete_youtube_video": false,
    "format_disks": false,
    "edit_tokens": false,
    "bypass_dedupe": false,
    "bypass_channel_guard": false,
    "bypass_vfr_safety": false
  },
  "upload_policy": {
    "allowed": true,
    "default_privacy": "private",
    "allowed_privacy": ["private"],
    "public_requires_manual_human_review": true,
    "schedule_public_requires_manual_human_review": true,
    "write_review_queue": true
  },
  "idle_work_policy": {
    "enabled": true,
    "only_when_no_active_upload": true,
    "only_when_no_active_ffmpeg_render": true,
    "only_when_cpu_below_percent": 70,
    "only_when_disk_free_above_percent": 10,
    "max_runtime_minutes_per_cycle": 60,
    "no_raw_delete": true,
    "no_destructive_moves": true
  },
  "required_validation": {
    "py_compile": true,
    "dry_run": true,
    "report": true,
    "before_after_summary": true,
    "review_queue_after_upload": true,
    "manual_confirm_before_upload": true
  }
}
