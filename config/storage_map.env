# StateVerge production volumes (Server Mode). Legacy SSD paths are separate keys below.
SV_CACHE=/Volumes/SV_CACHE
# Shorts highlight scan pool (shorts_cut_upload_job); override path if moved
STATEVERGE_SHORTS_MATERIALS_DIR=/Volumes/SV_CACHE/air
STATEVERGE_SHORTS_PORTRAIT_ONLY=0
# Pre-cut police/siren Shorts pool (idle_extract_police_clips.py)
STATEVERGE_SHORTS_POLICE_CLIPS_DIR=/Volumes/SV_CACHE/素材/police_clips
SV_TRANSFER=/Volumes/SV_TRANSFER
SV_BACKUP=/Volumes/SV_BACKUP
SV_ARCHIVE=/Volumes/SV_ARCHIVE

# Legacy fallbacks (read/migrate only; do not treat as primary production targets)
STATEVERGE_LEGACY=/Volumes/StateVerge
SV_WORK_LEGACY=/Volumes/SV_WORK

# Do not use STATEVERGE_VOL=/Volumes/StateVerge as the primary layout; prefer SV_* above.
# STATEVERGE_VOL=/Volumes/StateVerge
