# StateVerge root (optional; default is ~/StateVerge)
# STATEVERGE_ROOT=/path/to/StateVerge

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# ElevenLabs
ELEVENLABS_API_KEY=
# Optional: Sync Lipsync API (separate from TTS; falls back to manual if unset)
ELEVEN_LIPSYNC_API_KEY=
# Base host for relative ELEVEN_LIPSYNC_ENDPOINT (e.g. https://api.elevenlabs.io)
ELEVEN_LIPSYNC_BASE_URL=
ELEVEN_LIPSYNC_ENDPOINT=
ELEVEN_LIPSYNC_MODEL=sync-lipsync-2-pro
# Optional; default in code is v1/lip-sync/jobs (verify against your plan’s paths)
ELEVEN_LIPSYNC_POLL_PREFIX=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.0
ELEVENLABS_USE_SPEAKER_BOOST=true

# LTX
LTX_API_KEY=
LTX_API_BASE_URL=

# Runway (optional; Lip Sync API is account-dependent — use manual web upload if unset)
RUNWAY_API_KEY=
# Base URL and version prefix for healthcheck GET and relative RUNWAY_LIPSYNC_ENDPOINT
RUNWAY_API_BASE_URL=
RUNWAY_API_VERSION=
# HTTP resource path or full URL for POST Lip Sync (empty => CLI uses manual_required)
RUNWAY_LIPSYNC_ENDPOINT=

# Stock media (see docs/MEDIA_SYSTEM.md)
PEXELS_API_KEY=
PIXABAY_API_KEY=
# DVIDS public search often requires a free key; register at https://api.dvidshub.net/
DVIDS_API_KEY=

# Financial Modeling Prep (stock fundamentals, earnings — see src/integrations/fmp_client.py)
FMP_API_KEY=
# Stable API (new keys); legacy /api/v3 path URLs are not supported for new accounts
FMP_API_BASE=https://financialmodelingprep.com/stable

# Envato
ENVATO_API_KEY=
