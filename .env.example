# StateVerge — copy to .env.local

# Preferred for Neon / hosted Postgres:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# If DATABASE_URL is unset, discrete vars are used (see lib/db/pgPool.js):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=nationmatrix

# Optional — database migration scripts (see docs/NEON_MIGRATION_PLAN.md):
# LOCAL_DATABASE_URL=postgresql://USER@localhost:5432/nationmatrix
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
