# StateVerge — copy to .env.local

# Preferred for Neon / hosted Postgres:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# If DATABASE_URL is unset, discrete vars are used (see lib/db/pgPool.js):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=nationmatrix

# Optional — database migration scripts (see docs/NEON_MIGRATION_PLAN.md):
# LOCAL_DATABASE_URL=postgresql://USER@localhost:5432/nationmatrix
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Political Archive (Python, src/stateverge/cn_news/archive) ---
# Copy to .env.local and fill in. Never commit real values; GitHub Actions uses repo Secrets instead.
# X API (console.x.com → App → Keys and tokens; OAuth 1.0a, Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# GovInfo (https://api.data.gov/signup); empty = DEMO_KEY
GOVINFO_API_KEY=
# Optional LLM stance judge
# OPENAI_API_KEY=
# ARCHIVE_STANCE_MODEL=gpt-4o-mini
